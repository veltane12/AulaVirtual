<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="2dp"
    android:background="@drawable/bg_list_item">

    <LinearLayout
        android:id="@+id/layoutScheduleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/layoutScheduleActions"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvScheduleSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Materia"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvScheduleProfessor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profesor"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvScheduleSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sección 01"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:background="@drawable/bg_badge_primary"
                android:textColor="@color/white"
                android:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScheduleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Días y Horario"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutScheduleActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditSchedule"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/white"
            app:backgroundTint="@color/bs_success"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Editar horario"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteSchedule"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="@color/white"
            app:backgroundTint="@color/bs_danger"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Eliminar horario"/>
    </LinearLayout>

</RelativeLayout>
