<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Categoria: Apariencia -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apariencia"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modo Oscuro"
                        android:textSize="18sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_centerVertical="true"/>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paleta de Colores"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginBottom="12dp"/>

                <!-- Fila 1: Claros -->
                <LinearLayout
                    android:id="@+id/rowLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBlueLight" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_blue_light" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRedLight" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_red_light" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGreenLight" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_green_light" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPurpleLight" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_purple_light" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCyanLight" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_cyan_light" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnYellowLight" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_yellow_light" android:layout_marginHorizontal="4dp"/>
                </LinearLayout>

                <!-- Fila 2: Normales -->
                <LinearLayout
                    android:id="@+id/rowNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBlue" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_blue" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRed" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_red" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGreen" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_green" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPurple" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_purple" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCyan" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_cyan" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnYellow" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_yellow" android:layout_marginHorizontal="4dp"/>
                </LinearLayout>

                <!-- Fila 3: Oscuros -->
                <LinearLayout
                    android:id="@+id/rowDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBlueDark" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_blue_dark" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnRedDark" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_red_dark" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnGreenDark" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_green_dark" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPurpleDark" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_purple_dark" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnCyanDark" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_cyan_dark" android:layout_marginHorizontal="4dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnYellowDark" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_yellow_dark" android:layout_marginHorizontal="4dp"/>
                </LinearLayout>

                <!-- Ubicación de la Barra de Navegación -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación de la Barra de Navegación"
                    android:textSize="18sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleNavbarPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavPositionTop"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Arriba (Superior)"
                        android:textAllCaps="false"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNavPositionBottom"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Abajo (Inferior)"
                        android:textAllCaps="false"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bs_border"
                    android:layout_marginVertical="16dp"/>

                <!-- Soporte y Ayuda: Contactar Administrador -->
                <LinearLayout
                    android:id="@+id/layoutContactAdminContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Soporte y Ayuda"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContactAdmin"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✉️ Contactar con un Administrador"
                        android:textAllCaps="false"
                        app:strokeColor="?attr/colorPrimary"
                        app:strokeWidth="1.5dp"
                        android:textColor="?attr/colorPrimary"/>
                </LinearLayout>

                <!-- Categoria: Otros -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Otros"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="16dp">

                    <Button
                        android:id="@+id/btnChangePassword"
                        style="@style/Widget.Bootstrap.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="Cambiar Contraseña"
                        android:textAllCaps="false"/>

                    <Button
                        android:id="@+id/btnDownloadOfflineData"
                        style="@style/Widget.Bootstrap.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="Descargar Offline"
                        android:textAllCaps="false"/>

                </GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
