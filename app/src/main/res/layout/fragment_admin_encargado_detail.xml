<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER DEL ENCARGADO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de Encargado del Estudiante"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvEncargadoName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Encargado"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"/>

                <TextView
                    android:id="@+id/tvEncargadoCarnet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carnet: ENC0000000"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvEncargadoEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email: no_registrado@mail.com"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- HEADER SECCIÓN ESTUDIANTES -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Estudiantes bajo su Cargo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddStudentToEncargado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="+ Añadir Alumno"
                android:textSize="12sp"
                app:cornerRadius="20dp"/>
        </RelativeLayout>

        <!-- MENSAGE SI NO HAY ESTUDIANTES -->
        <TextView
            android:id="@+id/tvNoStudentsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este encargado aún no tiene estudiantes asignados."
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:padding="24dp"
            android:visibility="gone"/>

        <!-- RECYCLERVIEW DE ESTUDIANTES DE ESTE ENCARGADO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEncargadoStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
