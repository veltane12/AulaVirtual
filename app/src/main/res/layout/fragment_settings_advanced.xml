<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Categoria: Modo de Almacenamiento y Conexión -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo de Almacenamiento y Conexión"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvDataModeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Elige si deseas usar los datos almacenados localmente en el dispositivo o mediante la conexión al servidor."
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleDataMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeLocal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📱 Local (Interno)"
                        android:textSize="13sp"
                        android:padding="8dp"
                        android:textAllCaps="false"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModeServer"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌐 Servidor (Online)"
                        android:textSize="13sp"
                        android:padding="8dp"
                        android:textAllCaps="false"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Botón Descargar Offline en Modo de Almacenamiento -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadOfflineData"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="📥 Descargar Datos del Servidor (Offline)"
                    android:textAllCaps="false"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1.5dp"
                    android:textColor="?attr/colorPrimary"/>

                <!-- Botón Subir Registros Locales al Servidor -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadOfflineData"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="📤 Subir Datos Locales al Servidor (Online)"
                    android:textAllCaps="false"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1.5dp"
                    android:textColor="?attr/colorPrimary"/>

                <!-- Botón Eliminar Datos Descargados Offline -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearOfflineData"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="🗑️ Eliminar Datos Descargados del Servidor"
                    android:textAllCaps="false"
                    app:strokeColor="@color/bs_danger"
                    app:strokeWidth="1.5dp"
                    android:textColor="@color/bs_danger"/>

                <!-- Botón Configurar Servidor solo visible para Administradores -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfigureServerUrl"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="⚙️ Configurar Servidor (Administradores)"
                    android:textAllCaps="false"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1.5dp"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"/>

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bs_border"
                    android:layout_marginVertical="16dp"/>

                <!-- Soporte y Ayuda: Contactar Administrador -->
                <LinearLayout
                    android:id="@+id/layoutContactAdminContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Soporte y Ayuda"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:textAllCaps="true"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnContactAdmin"
                        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✉️ Contactar con un Administrador"
                        android:textAllCaps="false"
                        app:strokeColor="?attr/colorPrimary"
                        app:strokeWidth="1.5dp"
                        android:textColor="?attr/colorPrimary"/>

                    <!-- Separador -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/bs_border"
                        android:layout_marginVertical="16dp"/>
                </LinearLayout>

                <!-- Categoria: Otros -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Otros"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBiometricAutofill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="🔒 Datos Biométricos / Autocompletado"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:checked="true"
                    app:useMaterialThemeColors="true"/>

                <Button
                    android:id="@+id/btnChangePassword"
                    style="@style/Widget.Bootstrap.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🔑 Cambiar Contraseña"
                    android:textAllCaps="false"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
